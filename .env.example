# --- Serveur ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local : mongodb://127.0.0.1:27017/velox
# Atlas : mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/velox?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/velox

# --- Authentification JWT ---
# Genere une valeur longue : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_with_a_very_long_random_string
JWT_EXPIRES_IN=7d

# --- CORS (origines autorisees, separees par des virgules ; * = tout en dev) ---
CORS_ORIGIN=*

# --- Cles API externes (restent UNIQUEMENT cote serveur) ---
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
